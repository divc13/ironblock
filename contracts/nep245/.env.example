# Copy this file to .env and adjust the values. .env is git-ignored.
# Account IDs only; never put private keys or seed phrases in this file.

# near-cli-rs network connection name (testnet, mainnet, or a custom name
# configured in ~/Library/Application Support/near-cli/config.toml).
NEAR_NETWORK=testnet

# The account that holds the contract code.
CONTRACT_ACCOUNT_ID=ironblock-items.testnet

# The account allowed to call mint_genesis() and ownership methods.
# Defaults to CONTRACT_ACCOUNT_ID when omitted.
OWNER_ACCOUNT_ID=ironblock-items.testnet

# The account that receives the one-time genesis supply.
TREASURY_ACCOUNT_ID=ironblock-treasury.testnet

# Optional path override for the release wasm.
# WASM_PATH=target/wasm32-unknown-unknown/release/ironblock_nep245.wasm

# Optional near-cli-rs binary name/path.
# NEAR_CLI=near
