# Public NEAR testnet configuration
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_NEP245_CONTRACT_ID=v2.ironblock-items.testnet

# ---------------------------------------------------------------------------
# Login mode
#   auth0: public deployment; Google/email through your own Auth0 SPA tenant.
#   near:  local NEAR Auth/MPC spike using the shared testnet tenant below.
# Set both values to the same mode. `AUTH_MODE` is server-only; VITE_AUTH_MODE is
# compiled into the browser bundle. The build fails if they disagree.
# ---------------------------------------------------------------------------
AUTH_MODE=near
VITE_AUTH_MODE=near

# Your own Auth0 SPA application (public values only; never a client secret).
# For public deployment use these and set AUTH_MODE=auth0 / VITE_AUTH_MODE=auth0.
# Add the deployment origins to the Auth0 app:
#   Allowed Callback URLs: https://ironblock.up.railway.app, http://localhost:3000
#   Allowed Web Origins:   https://ironblock.up.railway.app, http://localhost:3000
#   Allowed Logout URLs:   https://ironblock.up.railway.app, http://localhost:3000
# The ID-token audience is the SPA client id, so AUTH0_AUDIENCE is optional and
# defaults to AUTH0_CLIENT_ID.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
AUTH0_JWKS_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_GOOGLE_CONNECTION=google-oauth2

# NEAR Auth testnet (public Auth0 SPA values; safe to ship to browsers).
# Used only when AUTH_MODE=near. The client id below is the shared public NEAR
# Auth testnet Auth0 application. The shared app allows this callback URL; use
# the same port for `npm run dev`:
#   http://localhost:3000
VITE_NEAR_AUTH_NETWORK=testnet
VITE_NEAR_AUTH_CLIENT_ID=np8paqIpMWmNbzT4xAvOOapZBjsOpptl
VITE_NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
# Auth0 API audience for the login access token verified by the game server.
# Do not use the NEAR Auth signing audience here: Auth0 requires a transaction
# payload for that audience and rejects a plain login with `access_denied`.
VITE_NEAR_AUTH_AUDIENCE=https://api.testnet.fast-auth.com
# NEAR Auth guard audience, requested only for transaction signatures.
VITE_NEAR_AUTH_SIGNING_AUDIENCE=auth0.jwt.fast-auth.testnet
VITE_NEAR_AUTH_FAST_AUTH_CONTRACT_ID=fast-auth.testnet
VITE_NEAR_AUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet

# Server-only NEAR Auth settings. Do not expose these with a VITE_ prefix.
# The issuer and domain must describe the same Auth0 tenant. The build fails if
# the public VITE_* auth values disagree with these server values.
NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
NEAR_AUTH_ISSUER=https://login.testnet.fast-auth.com/
# Must match VITE_NEAR_AUTH_AUDIENCE (the login API audience).
NEAR_AUTH_AUDIENCE=https://api.testnet.fast-auth.com
NEAR_AUTH_JWKS_URL=https://login.testnet.fast-auth.com/.well-known/jwks.json
NEAR_AUTH_RPC_URL=https://rpc.testnet.near.org
NEAR_AUTH_FAST_AUTH_CONTRACT_ID=fast-auth.testnet
NEAR_AUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet

# Required for `npm start` / any non-development server. Generate once and keep
# secret: openssl rand -base64 48
# When omitted during `npm run dev`, Vite creates an ephemeral in-memory secret.
NEAR_AUTH_SESSION_SECRET=
NEAR_AUTH_SESSION_TTL_SECONDS=3600

# In-process login/MPC abuse protection (not distributed).
NEAR_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
NEAR_AUTH_RATE_LIMIT_IP_MAX=20
NEAR_AUTH_RATE_LIMIT_SUBJECT_MAX=8
NEAR_AUTH_RATE_LIMIT_CONCURRENT_MAX=4

# ---------------------------------------------------------------------------
# Settlement / NEP-245 withdrawal (server-only, testnet only).
# These default to the final deployed contract and treasury. Never expose the
# treasury key through a VITE_* variable and never commit the keystore file.
# ---------------------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_NEP245_CONTRACT_ID=v2.ironblock-items.testnet
NEAR_TREASURY_ACCOUNT_ID=v2.ironblock-treasury.testnet

# Treasury signer. Prefer the near-cli keystore file (default near-cli location,
# single-line JSON such as {"account_id":...,"private_key":"ed25519:..."}):
#   ~/.near-credentials/testnet/v2.ironblock-treasury.testnet.json
NEAR_TREASURY_KEYSTORE_PATH=
# Or, alternatively, an inline secret key (ed25519:base58). Leave blank when a
# keystore path is provided; never commit either value.
NEAR_TREASURY_PRIVATE_KEY=

# mt_transfer finality wait budget in milliseconds (default 45s).
NEAR_SETTLEMENT_TIMEOUT_MS=45000

# Built production host (`npm start`). The base path must match the Vite build
# base (for example build with `vite build --base=/quest/`).
IRONBLOCK_BASE_PATH=/
PORT=3000
HOST=0.0.0.0

# Live NPC economy loop (production, Vite dev and preview). One tick every
# IRONBLOCK_LIVE_TICK_MS advances IRONBLOCK_LIVE_TICK_SECONDS of simulation.
# Leave the seconds value blank for the default 1 in-game second per real
# second. Raise it to accelerate the town; high ratios flood the event feed.
IRONBLOCK_LIVE_TICK_MS=1000
IRONBLOCK_LIVE_TICK_SECONDS=
# Live ticks are persisted in batches; this is the maximum delay between full
# world saves. Shutdown always flushes once.
IRONBLOCK_LIVE_SAVE_MS=15000
